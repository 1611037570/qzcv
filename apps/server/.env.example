# 环境变量模板：只保留变量名，值为空；实际值写入不入库的分环境文件 .env.{运行环境}
# 加载优先级：系统/pm2 环境变量 > .env.{运行环境}（分环境，不入库）

# ===== 数据库 =====
# 简历数据库主机
DB_RESUME_HOST=
# 简历数据库端口
DB_RESUME_PORT=
# 简历数据库用户名
DB_RESUME_USERNAME=
# 简历数据库密码
DB_RESUME_PASSWORD=
# 简历数据库名称
DB_RESUME_DATABASE=

# ===== 人工智能上游 =====
# 上游密钥
OPENAI_API_KEY=
# 上游完整地址
OPENAI_BASE_URL=
# 上游模型（必填，缺失会启动报错）
OPENAI_MODEL=

# ===== 站点与打印 =====
# 站点对外访问根地址，本地填前端开发地址，生产填站点域名，不要以 / 结尾（必填，缺失会启动报错）
PUBLIC_SITE_URL=
# 单次渲染总超时（含页面加载、等待就绪与生成），单位毫秒
PDF_RENDER_TIMEOUT=

# ===== 第三方集成 =====
# 第三方上游超时，单位毫秒
INTEGRATIONS_TIMEOUT=

# ===== 开源仓库 =====
# 仓库星标缓存有效期，单位毫秒
GITHUB_STARS_CACHE_TTL=