# 环境变量模板：只保留变量名，值为空；实际值写入不入库的分环境文件 .env.{运行环境}
# 加载优先级：系统/pm2 环境变量 > .env.{运行环境}（分环境，不入库）

# ===== 数据库 =====
# 简历数据库主机
DB_RESUME_HOST=
# 简历数据库端口
DB_RESUME_PORT=
# 简历数据库用户名
DB_RESUME_USERNAME=
# 简历数据库密码
DB_RESUME_PASSWORD=
# 简历数据库名称
DB_RESUME_DATABASE=

# ===== 人工智能上游 =====
# 上游密钥
OPENAI_API_KEY=
# 上游完整地址，必须是对话补全接口（chat/completions），与前端 chatCompletions 协议一致
OPENAI_BASE_URL=
# 模型命名规则：前端传 snowflake:<用途>，服务端读取 OPENAI_MODEL_<用途>（用途大写）。
# 增加新用途只需新增一个 OPENAI_MODEL_<用途> 变量，服务端无需改代码。
# 兜底模型（对话与面试），必填，缺失会启动报错，对应用途 assistant
OPENAI_MODEL_ASSISTANT=
# 解析模型（导入简历解析），需具备图片识别能力，对应用途 parser；留空则回退兜底模型
OPENAI_MODEL_PARSER=
# 每个使用者的免费令牌额度，仅用于展示剩余量，本阶段不做拦截
LLM_FREE_TOKENS=

# ===== 站点与打印 =====
# 站点对外访问根地址，本地填前端开发地址，生产填站点域名，不要以 / 结尾（必填，缺失会启动报错）
PUBLIC_SITE_URL=
# 单次渲染总超时（含页面加载、等待就绪与生成），单位毫秒
PDF_RENDER_TIMEOUT=

# ===== 第三方集成 =====
# 第三方上游超时，单位毫秒
INTEGRATIONS_TIMEOUT=

# ===== 开源仓库 =====
# 仓库星标缓存有效期，单位毫秒
GITHUB_STARS_CACHE_TTL=